generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
model CanonicalEvent { id String @id @default(cuid()); title String; description String?; category String?; tags String[]; createdAt DateTime @default(now()); markets Market[] }
model Market { id String @id @default(cuid()); externalId String; protocol String; chain String?; title String; description String?; outcomes Json; category String?; tags String[]; createdAt DateTime @default(now()); closeTime DateTime?; resolutionTime DateTime?; resolutionSource String?; status String; marketUrl String?; creator String?; liquidity Float?; volume Float?; prices Json?; embedding Unsupported("vector(1536)")?; canonicalMarketId String?; canonicalEventId String?; canonicalEvent CanonicalEvent? @relation(fields: [canonicalEventId], references: [id]); @@unique([protocol, externalId]); @@index([protocol, status]); @@index([canonicalEventId]) }
model MarketSnapshot { id String @id @default(cuid()); marketId String; timestamp DateTime @default(now()); probability Float; outcomePrices Json; liquidity Float; volume Float; openInterest Float?; @@index([marketId,timestamp]) }
model RiskConfiguration { id String @id @default(cuid()); protocolId String?; thresholds Json; active Boolean @default(true); createdAt DateTime @default(now()) }
model Organization { id String @id @default(cuid()); name String; createdAt DateTime @default(now()); protocols Protocol[]; apiKeys ApiKey[] }
model Protocol { id String @id @default(cuid()); name String; organizationId String; organization Organization @relation(fields:[organizationId],references:[id]); createdAt DateTime @default(now()); webhooks WebhookSubscription[] }
model ApiKey { id String @id @default(cuid()); prefix String; hash String; permissions String[]; rateLimitTier String; organizationId String; organization Organization @relation(fields:[organizationId],references:[id]); createdAt DateTime @default(now()); lastUsedAt DateTime?; revokedAt DateTime?; @@unique([prefix]) }
model ResolutionSource { id String @id @default(cuid()); url String @unique; domain String; type String; reliabilityScore Int; availability Boolean; lastCheckedAt DateTime; historicalUsage Int; disputeCount Int }
model WebhookSubscription { id String @id @default(cuid()); protocolId String; protocol Protocol @relation(fields:[protocolId],references:[id]); url String; secretHash String; events String[]; active Boolean @default(true); createdAt DateTime @default(now()); deliveries WebhookDelivery[] }
model WebhookDelivery { id String @id @default(cuid()); subscriptionId String; subscription WebhookSubscription @relation(fields:[subscriptionId],references:[id]); event String; idempotencyKey String @unique; status String; attempts Int @default(0); responseCode Int?; createdAt DateTime @default(now()) }
model EventRelationship { id String @id @default(cuid()); sourceEventId String; targetEventId String; relationshipType String; confidence Float; reason String; createdAt DateTime @default(now()); @@index([sourceEventId]); @@index([targetEventId]) }
model ResolutionRecord { id String @id @default(cuid()); marketId String; canonicalEventId String; resolvedOutcome String; resolutionSource String; resolvedAt DateTime; disputed Boolean @default(false); disputeReason String?; sourceSnapshot Json; resolutionConfidence Float; contentHash String; createdAt DateTime @default(now()) }
model ResolutionRevision { id String @id @default(cuid()); resolutionId String; previousOutcome String; newOutcome String; reason String; createdAt DateTime @default(now()) }
model DataProvenance { id String @id @default(cuid()); entityType String; entityId String; sourceType String; protocol String?; endpoint String?; blockchain String?; transactionHash String?; blockNumber String?; url String?; retrievedAt DateTime; rawDataHash String; @@index([entityType,entityId]) }
model IntelligenceSignal { id String @id @default(cuid()); type String; eventId String?; severity String; confidence Float; payload Json; contentHash String; previousHash String?; createdAt DateTime @default(now()); @@index([type,createdAt]); @@index([eventId]) }
model ConsensusSnapshot { id String @id @default(cuid()); canonicalEventId String; probability Float; confidenceScore Int; contentHash String; createdAt DateTime @default(now()); @@index([canonicalEventId,createdAt]) }
model ProtocolReputationSnapshot { id String @id @default(cuid()); protocolId String; score Int; contentHash String; createdAt DateTime @default(now()); @@index([protocolId,createdAt]) }
