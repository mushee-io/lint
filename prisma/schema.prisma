generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  DEVELOPER
  ANALYST
  VIEWER
}

enum FreshnessStatus {
  FRESH
  AGING
  STALE
  UNKNOWN
}

enum PilotStatus {
  INVITED
  SANDBOX
  INTEGRATING
  LIVE_TEST
  PILOT_ACTIVE
  REVIEW
  PRODUCTION_READY
  ENDED
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  createdAt   DateTime                 @default(now())
  memberships OrganizationMembership[]
  protocols   Protocol[]
  apiKeys     ApiKey[]
  pilots      Pilot[]
  watches     WatchRegistration[]
  feedback    Feedback[]
}

model User {
  id          String                   @id @default(cuid())
  email       String                   @unique
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Protocol {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  watches        WatchRegistration[]
  pilots         Pilot[]

  @@unique([organizationId, name])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  prefix         String       @unique
  hash           String
  permissions    String[]
  environment    String       @default("sandbox")
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol       Protocol?    @relation(fields: [protocolId], references: [id])
  protocolId     String?
}

model CanonicalEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  markets     Market[]
}

model Market {
  id               String              @id @default(cuid())
  externalId       String
  protocolName     String
  title            String
  description      String?
  outcomes         Json
  status           String
  prices           Json?
  liquidity        Float?
  volume           Float?
  resolutionSource String?
  freshness        FreshnessStatus     @default(UNKNOWN)
  canonicalEventId String?
  canonicalEvent   CanonicalEvent?     @relation(fields: [canonicalEventId], references: [id])
  snapshots        MarketSnapshot[]
  provenance       DataProvenance[]
  watches          WatchRegistration[]

  @@unique([protocolName, externalId])
}

model MarketSnapshot {
  id            String   @id @default(cuid())
  marketId      String
  timestamp     DateTime @default(now())
  probability   Float?
  outcomePrices Json?
  liquidity     Float?
  volume        Float?
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, timestamp])
}

model DataProvenance {
  id                   String   @id @default(cuid())
  marketId             String
  source               String
  externalMarketId     String
  retrievedAt          DateTime
  rawPayloadHash       String
  normalizationVersion String
  market               Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

model EventRelationship {
  id               String   @id @default(cuid())
  sourceEventId    String
  targetEventId    String
  relationshipType String
  confidence       Float
  reason           String
  createdAt        DateTime @default(now())
}

model WatchRegistration {
  id             String       @id @default(cuid())
  organizationId String
  protocolId     String
  marketId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol       Protocol     @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  market         Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([organizationId, marketId])
}

model Pilot {
  id             String       @id @default(cuid())
  organizationId String
  protocolId     String
  status         PilotStatus  @default(INVITED)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol       Protocol     @relation(fields: [protocolId], references: [id], onDelete: Cascade)
}

model Feedback {
  id             String       @id @default(cuid())
  organizationId String
  targetType     String
  targetId       String
  label          String
  comment        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
