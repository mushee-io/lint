{
  "name": "market-lint",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "smoke:polymarket": "tsx scripts/live-polymarket-smoke.ts",
    "smoke:manifold": "tsx scripts/live-manifold-smoke.ts",
    "smoke:resilience": "tsx scripts/resilience-smoke.ts",
    "soak:worker": "tsx scripts/worker-soak.ts",
    "pilot:preflight": "tsx scripts/pilot-preflight.ts",
    "security:audit": "node scripts/security-audit.mjs",
    "db:generate": "prisma generate",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dotenv": "^17.2.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
