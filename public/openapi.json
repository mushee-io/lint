{
  "openapi": "3.0.3",
  "info": {
    "title": "Market Lint API",
    "version": "1.0.0",
    "description": "Prediction-market intelligence infrastructure: Guard, Watch, Event Graph, Consensus, enterprise controls and measured partner pilots."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiKey": { "type": "apiKey", "in": "header", "name": "x-api-key" }
    }
  },
  "paths": {
    "/api/v1/guard": { "post": { "summary": "Pre-listing market risk gate" } },
    "/api/v1/markets": { "get": { "summary": "List normalized markets" } },
    "/api/v1/markets/{id}/intelligence": { "get": { "summary": "Get seven-dimension market intelligence" } },
    "/api/v1/markets/{id}/review": { "post": { "summary": "Run grounded market reviewer" } },
    "/api/v1/markets/{id}/decision": { "post": { "summary": "Persist operator market decision" } },
    "/api/v1/watch": { "post": { "summary": "Register continuous market surveillance" } },
    "/api/v1/signals": { "get": { "summary": "List tenant risk signals" } },
    "/api/v1/incidents": { "get": { "summary": "List Watch incidents" } },
    "/api/v1/incidents/{id}": { "post": { "summary": "Acknowledge, resolve or reopen an incident with response-time measurement" } },
    "/api/v1/events": { "get": { "summary": "List canonical events" } },
    "/api/v1/events/{id}/graph": { "get": { "summary": "Get universal event graph neighborhood" } },
    "/api/v1/event-relationships": { "get": { "summary": "List event relationship review queue" } },
    "/api/v1/event-relationships/{id}": { "post": { "summary": "Decide an event relationship" } },
    "/api/v1/events/{id}/consensus": { "get": { "summary": "Get cross-protocol consensus and confidence" } },
    "/api/v1/events/{id}/divergence": { "get": { "summary": "Get cross-protocol divergence intelligence" } },
    "/api/v1/protocols/{protocol}/reputation": { "get": { "summary": "Get observed protocol data reliability" } },
    "/api/v1/webhooks": { "get": { "summary": "List webhook endpoints" }, "post": { "summary": "Create webhook endpoint" }, "delete": { "summary": "Deactivate webhook endpoint" } },
    "/api/v1/webhooks/stats": { "get": { "summary": "Get tenant webhook delivery statistics" } },
    "/api/v1/webhooks/replay": { "post": { "summary": "Replay a failed webhook delivery" } },
    "/api/v1/api-keys": { "get": { "summary": "List API keys" }, "post": { "summary": "Create API key" }, "delete": { "summary": "Revoke API key" } },
    "/api/v1/api-keys/rotate": { "post": { "summary": "Rotate an API key" } },
    "/api/v1/enterprise/policy": { "get": { "summary": "Get tenant enterprise policy" } },
    "/api/v1/enterprise/usage": { "get": { "summary": "Get tenant API usage and quota state" } },
    "/api/v1/enterprise/readiness": { "get": { "summary": "Get production-readiness evidence" } },
    "/api/v1/enterprise/audit-export": { "get": { "summary": "Export tenant audit evidence as CSV or JSON" } },
    "/api/v1/pilots/{id}/activate": { "post": { "summary": "Activate a measured partner pilot and issue a protocol-bound live key" } },
    "/api/v1/partner/markets": { "post": { "summary": "Ingest a partner market-feed batch and optionally place markets under Watch" } },
    "/api/v1/pilots/{id}/status": { "get": { "summary": "Get partner-pilot integration checklist and measured status" } },
    "/api/v1/pilots/{id}/report": { "get": { "summary": "Get pilot metrics or generate the persisted JSON+HTML impact report" } },
    "/api/v1/feedback": { "get": { "summary": "List tenant feedback" }, "post": { "summary": "Submit partner feedback including false-positive and false-negative labels" } }
  },
  "security": [{ "bearerAuth": [] }, { "apiKey": [] }]
}
